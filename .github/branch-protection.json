{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "fmt",
      "clippy",
      "rust-unit",
      "rust-integration",
      "frontend-lint",
      "frontend-unit",
      "frontend-build",
      "e2e",
      "a11y",
      "visual",
      "openapi-compat",
      "security-secrets",
      "security-deps",
      "security-image",
      "docs-build",
      "sow-lint"
    ]
  },
  "enforce_admins": false,
  "required_pull_request_reviews": null,
