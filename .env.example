# AI-Lab environment. Copy to .env and fill the required values.
# Never commit .env. Never put a real secret in this file.

AILAB_ENV=production
AILAB_BIND=127.0.0.1
AILAB_PORT=8080
AILAB_DATABASE_URL=postgres://ailab_app:ailab_app@localhost:5432/ailab
AILAB_APP_DB_PASSWORD=ailab_app
AILAB_MIGRATE_DB_PASSWORD=ailab_migrate
AILAB_READONLY_DB_PASSWORD=ailab_readonly
AILAB_REDIS_URL=redis://localhost:6379/0
AILAB_MASTER_KEY=replace-with-base64-encoded-32-bytes
AILAB_API_TOKEN=
AILAB_LOG_LEVEL=info
AILAB_LOG_FORMAT=json
AILAB_OTEL_ENDPOINT=
AILAB_METRICS_ENABLED=true
AILAB_ARTIFACTS_DIR=/var/lib/ailab/artifacts
AILAB_WORKSPACES_DIR=/var/lib/ailab/workspaces
AILAB_RUNNER_IMAGE=ailab/runner:1.0.0
AILAB_RUNNER_CPU=2
AILAB_RUNNER_MEMORY_MB=4096
AILAB_RUNNER_TIMEOUT_S=2700
AILAB_WORKER_CONCURRENCY=4
AILAB_SCHEDULER_TICK_MS=1000
AILAB_LEASE_TTL_S=900
AILAB_LLM_DEFAULT_MODEL=deepseek-flash
AILAB_LLM_ESCALATION_MODEL=deepseek-v4-pro
AILAB_GITHUB_API_URL=https://api.github.com
AILAB_GITHUB_WEBHOOK_SECRET=
AILAB_ALLOWED_ORIGINS=
AILAB_CORS_ENABLED=false
AILAB_RATE_LIMIT_READ_RPM=120
AILAB_RATE_LIMIT_WRITE_RPM=30
AILAB_MAX_REQUEST_BYTES=2097152
AILAB_PG_POOL_MAX=20
AILAB_REDIS_MAXMEMORY=512mb
AILAB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AILAB_MEMORY_TOP_K=8
AILAB_MEMORY_CACHE_TTL_S=300
AILAB_PROMPT_RETENTION_DAYS=90
AILAB_EPISODE_RETENTION_DAYS=180
AILAB_BUDGET_DEFAULT_PER_CARD_USD=5.0
AILAB_BUDGET_DEFAULT_PER_DAY_USD=50.0
AILAB_SEED_DEMO=false
AILAB_RUNNER_TOKEN=
AILAB_RUNNER_URL=http://runner:8081
AILAB_RUNNER_BIND=0.0.0.0:8081
