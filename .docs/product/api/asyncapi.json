  "components": {
    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "required": [
          "event_id",
          "event",
          "seq",
          "lab_id",
          "occurred_at",
          "payload"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "event": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "lab_id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
