{
  "asyncapi": "3.0.0",
  "info": {
    "title": "AI-Lab Event Stream",
    "version": "1.0.0",
    "description": "WebSocket event envelope and core channels."
  },
  "servers": {
    "ws": {
      "host": "127.0.0.1:8080",
      "protocol": "wss",
      "pathname": "/api/v1/ws"
    }
  },
